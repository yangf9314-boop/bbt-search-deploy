# ===========================================
#  corpus/ 脚本运行时需要的环境变量
#  不要提交到 Git！只放本地。
#
#  用法：
#    终端里 export 之后再运行脚本：
#    export SUPABASE_URL=...
#    export SUPABASE_SERVICE_ROLE_KEY=...
#    python3 corpus/04_seed_db.py
# ===========================================

# Supabase（从 Settings → API → Secret keys → default 复制）
# ⚠️ Secret key 权限很高，绝对不要放前端代码里！
SUPABASE_URL=https://edyjrzcxeplzfpbovvxq.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# Cloudflare R2（从 R2 → Settings → API Tokens 创建）
# Endpoint 格式：https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
